    let gTimer=0,gActive=false,gInt=0,curHue=0;
    let vGlitchTimer = Math.random() * 5 + 3;
    let vGlitchPatches = [];

    function animate(time){
      requestAnimationFrame(animate);
      const t=time*0.001,dt=0.016,sf=scrollY*0.002;
      camera.position.y=3-sf+Math.sin(t*0.12)*0.15;camera.position.x=Math.sin(t*0.08)*0.4;camera.position.z+=Math.cos(t*0.06)*0.003;camera.lookAt(Math.sin(t*0.05)*0.2,1-sf*0.4+Math.cos(t*0.1)*0.1,0);
      sMat.opacity=0.3+Math.sin(t*1.2)*0.1;
      curHue+=(targetHue-curHue)*0.02;

      vGlitchTimer -= dt;
      if (vGlitchTimer <= 0) {
        const count = Math.floor(Math.random() * 2) + 1;
        for (let p = 0; p < count; p++) {
          const ridgeIdx = Math.floor(Math.random() * ridgeMeshes.length);
          const burstFrames = Math.floor(Math.random() * 6) + 3;
          vGlitchPatches.push({
            ridge: ridgeIdx,
            centerX: (Math.random() - 0.5) * 50,
            radius: Math.random() * 2.5 + 1,
            intensity: Math.random() * 1.2 + 0.5,
            life: burstFrames,
            maxLife: burstFrames,
            noiseSpeed: Math.random() * 20 + 10,
            zDisplace: Math.random() > 0.5,
          });
        }
        vGlitchTimer = Math.random() * 6 + 3;
      }

      ridgeMeshes.forEach((r, i) => {
        const pos = r.geo.attributes.position;
        let needsUpdate = false;
        const patches = vGlitchPatches.filter(p => p.ridge === i);
        if (patches.length > 0) {
          for (let v = 0; v < pos.count; v++) {
            let dy = 0, dz = 0;
            const vx = pos.getX(v);
            const vz = pos.getZ(v);
            for (const patch of patches) {
              const dx = vx - patch.centerX;
              const dist = Math.abs(dx);
              if (dist < patch.radius) {
                const factor = 1 - (dist / patch.radius);
                const lifeRatio = patch.life / patch.maxLife;
                const noiseVal = Math.sin(vx * patch.noiseSpeed + t * 50) *
                                 Math.cos(vz * patch.noiseSpeed * 0.7 + t * 30);
                dy += noiseVal * patch.intensity * factor * lifeRatio;
                if (Math.random() < 0.3 * factor) {
                  dy += (Math.random() - 0.5) * patch.intensity * 1.5 * lifeRatio;
                }
                if (patch.zDisplace) {
                  dz += (Math.random() - 0.5) * patch.intensity * 0.3 * factor * lifeRatio;
                }
              }
            }
            pos.setY(v, r.origY[v] + dy);
            if (dz !== 0) pos.setZ(v, pos.getZ(v) + dz);
          }
          needsUpdate = true;
        } else {
          if (r._wasGlitching) {
            for (let v = 0; v < pos.count; v++) {
              pos.setY(v, r.origY[v]);
            }
            needsUpdate = true;
            r._wasGlitching = false;
          }
        }
        if (patches.length > 0) r._wasGlitching = true;
        if (needsUpdate) {
          pos.needsUpdate = true;
          r.geo.computeVertexNormals();
        }
        const hsl={};r.baseColor.getHSL(hsl);
        r.solid.material.color.setHSL(hsl.h+curHue,hsl.s,hsl.l);
        r.wireMat.opacity=(0.03+i*0.008)+Math.sin(t*1.5+i)*0.01;
        if(gActive){
          r.solid.position.x=(Math.random()-0.5)*gInt*0.4;
          r.wire.position.x=r.solid.position.x+(Math.random()-0.5)*0.02;
        }else{
          r.solid.position.x*=0.9;
          r.wire.position.x*=0.9;
        }
      });

      vGlitchPatches.forEach(p => p.life--);
      vGlitchPatches = vGlitchPatches.filter(p => p.life > 0);

      gTimer-=dt;
      if(gTimer<=0){
        gActive=Math.random()<0.25;
        gInt=gActive?(Math.random()*0.12+0.03):0;
        gTimer=gActive?(Math.random()*0.08+0.03):(Math.random()*4+3);
      }

      nextShoot-=dt;if(nextShoot<=0){const idle=shooters.find(s=>!s.active);if(idle)idle.spawn();nextShoot=Math.random()*5+3;}
      shooters.forEach(s=>s.update());
      pl.position.x=Math.sin(t*0.3)*10;pl.position.z=Math.cos(t*0.2)*5;pl.intensity=0.5+Math.sin(t*1.2)*0.2;
      renderer.render(scene,camera);
