          });
          const glitchMaterial = new THREE.ShaderMaterial({
            uniforms: {
              uTexture: { value: photoTexture },
              uTime: { value: 0 },
              uGlitchIntensity: { value: 0 },
              uScanlines: { value: 0 },
            },
            vertexShader: `
              varying vec2 vUv;
              void main() {
                vUv = uv;
                gl_Position = vec4(position, 1.0);
              }
            `,
            fragmentShader: `
              uniform sampler2D uTexture;
              uniform float uTime;
              uniform float uGlitchIntensity;
              uniform float uScanlines;
              varying vec2 vUv;
              float circleMask(vec2 uv) {
                return smoothstep(0.5, 0.49, length(uv - 0.5));
              }
              float hash(float n) { return fract(sin(n) * 43758.5453123); }
              float hash2(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
              void main() {
                vec2 uv = vUv;
                float mask = circleMask(uv);
                float gi = uGlitchIntensity;
                if (gi > 0.0) {
                  float sliceY = floor(uv.y * 20.0) / 20.0;
                  float sliceRand = hash(sliceY + floor(uTime * 15.0));
                  if (sliceRand > 0.6) {
                    uv.x += (hash(sliceY + uTime * 3.0) - 0.5) * gi * 0.15;
                  }
                  float blockY = floor(uv.y * 8.0) / 8.0;
                  if (hash(blockY + floor(uTime * 8.0) * 0.7) > 0.85) {
                    uv.x += (hash(blockY * uTime) - 0.5) * gi * 0.25;
                  }
                }
                float ca = gi * 0.02 + 0.003 * sin(uTime * 0.5);
                float r = texture2D(uTexture, uv + vec2(ca, 0.0)).r;
                float g = texture2D(uTexture, uv).g;
                float b = texture2D(uTexture, uv - vec2(ca, 0.0)).b;
                vec3 color = vec3(r, g, b);
                float scanline = sin(vUv.y * 320.0 + uTime * 2.0) * 0.5 + 0.5;
                color -= scanline * (0.03 + uScanlines * 0.12);
                color += vec3(0.0, 0.0, 0.02) * (sin(uTime * 1.5) * 0.5 + 0.5);
                if (gi > 0.0) {
                  color += (hash2(vUv * 500.0 + uTime * 100.0) - 0.5) * gi * 0.15;
                  float tearY = hash(floor(uTime * 20.0));
                  if (abs(vUv.y - tearY) < 0.005 * gi) {
                    color = vec3(r * 1.5, g * 0.5, b * 1.8);
                  }
                }
                color *= 0.85 + 0.15 * (1.0 - smoothstep(0.3, 0.5, length(vUv - 0.5)));
                gl_FragColor = vec4(color, 1.0);
              }
            `,
            transparent: false,
          });
          const quad = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), glitchMaterial);
          glitchScene.add(quad);
          let glitchTimer = Math.random() * 5 + 4;
          let gActivePhoto = false, gDuration = 0, gElapsed = 0, gIntensity = 0;
          function animateGlitch(time) {
            requestAnimationFrame(animateGlitch);
            if (!glitchReady) return;
            const t = time * 0.001, dt = 1 / 60;
            glitchMaterial.uniforms.uTime.value = t;
            glitchTimer -= dt;
            if (!gActivePhoto && glitchTimer <= 0) {
              gActivePhoto = true;
              gDuration = Math.random() * 0.3 + 0.1;
              gElapsed = 0;
              glitchTimer = Math.random() * 6 + 3;
            }
            if (gActivePhoto) {
              gElapsed += dt;
              const p = gElapsed / gDuration;
              if (p < 0.3) gIntensity = p / 0.3;
              else if (p < 0.7) gIntensity = 1.0;
              else if (p < 1.0) gIntensity = 1.0 - (p - 0.7) / 0.3;
              else { gIntensity = 0; gActivePhoto = false; }
              if (Math.random() > 0.7) gIntensity *= 1.5;
            } else {
              gIntensity *= 0.9;
            }
            glitchMaterial.uniforms.uGlitchIntensity.value = gIntensity;
            glitchMaterial.uniforms.uScanlines.value = gIntensity;
            glitchRenderer.render(glitchScene, glitchCamera);
          }
          requestAnimationFrame(animateGlitch);
        } catch (e) {
          console.log('Glitch shader: WebGL unavailable, using fallback img');
        }
      }
    }

