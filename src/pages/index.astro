    // Shooting stars
    const TRAIL_PTS = 30;

    class ShootingStar {
      constructor() {
        this.active = false;
        this.trail = [];
        for (let i = 0; i < TRAIL_PTS; i++) this.trail.push({x:0,y:0,z:0});
        this.segments = [];
        const segCount = 5;
        for (let s = 0; s < segCount; s++) {
          const ptsPerSeg = Math.ceil(TRAIL_PTS / segCount);
          const positions = new Float32Array(ptsPerSeg * 3);
          const geo = new THREE.BufferGeometry();
          geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
          const opacity = (1 - s / segCount) * 0.6;
          const mat = new THREE.LineBasicMaterial({
            color: s === 0 ? 0xffffff : 0xc8c0ff,
            transparent: true, opacity: 0,
            blending: THREE.AdditiveBlending, depthWrite: false,
          });
          const line = new THREE.Line(geo, mat);
          scene.add(line);
          this.segments.push({ geo, mat, positions, maxOpacity: opacity, count: ptsPerSeg, startIdx: s * ptsPerSeg });
        }
        const hg = new THREE.BufferGeometry();
        hg.setAttribute('position', new THREE.BufferAttribute(new Float32Array(3), 3));
        this.hMat = new THREE.PointsMaterial({
          color: 0xffffff, size: 0.35, transparent: true, opacity: 0,
          map: starTex, depthWrite: false, blending: THREE.AdditiveBlending,
        });
        this.head = new THREE.Points(hg, this.hMat);
        scene.add(this.head);
        this.x = 0; this.y = 0; this.z = 0;
        this.vx = 0; this.vy = 0; this.vz = 0;
        this.ax = 0; this.ay = 0;
        this.life = 0; this.maxLife = 0;
      }

      spawn() {
        this.x = (Math.random() - 0.5) * 50;
        this.y = Math.random() * 12 + 12;
        this.z = (Math.random() - 0.5) * 20 - 15;
        const angle = Math.random() * 0.6 + 0.4;
        const side = Math.random() > 0.5 ? 1 : -1;
        const speed = Math.random() * 0.12 + 0.08;
        this.vx = side * Math.cos(angle) * speed;
        this.vy = -Math.sin(angle) * speed;
        this.vz = (Math.random() - 0.5) * 0.02;
        this.ax = (Math.random() - 0.5) * 0.001;
        this.ay = -Math.random() * 0.0005;
        this.maxLife = Math.random() * 100 + 80;
        this.life = this.maxLife;
        this.active = true;
        for (let i = 0; i < TRAIL_PTS; i++) {
          this.trail[i].x = this.x;
          this.trail[i].y = this.y;
          this.trail[i].z = this.z;
        }
      }

      update() {
        if (!this.active) return;
        this.life--;
        if (this.life <= 0) {
          this.active = false;
          this.segments.forEach(s => s.mat.opacity = 0);
          this.hMat.opacity = 0;
          return;
        }
        this.vx += this.ax;
        this.vy += this.ay;
        this.x += this.vx;
        this.y += this.vy;
        this.z += this.vz;
        for (let i = TRAIL_PTS - 1; i > 0; i--) {
          this.trail[i].x = this.trail[i-1].x * 0.98 + this.trail[i].x * 0.02;
          this.trail[i].y = this.trail[i-1].y * 0.98 + this.trail[i].y * 0.02;
          this.trail[i].z = this.trail[i-1].z * 0.98 + this.trail[i].z * 0.02;
        }
        this.trail[0].x = this.x;
        this.trail[0].y = this.y;
        this.trail[0].z = this.z;
        const lifeRatio = this.life / this.maxLife;
        const fade = lifeRatio > 0.85 ? (1 - lifeRatio) / 0.15 : lifeRatio > 0.1 ? 1 : lifeRatio / 0.1;
        this.segments.forEach(seg => {
          for (let i = 0; i < seg.count; i++) {
            const ti = Math.min(seg.startIdx + i, TRAIL_PTS - 1);
            seg.positions[i*3]   = this.trail[ti].x;
            seg.positions[i*3+1] = this.trail[ti].y;
            seg.positions[i*3+2] = this.trail[ti].z;
          }
          seg.geo.attributes.position.needsUpdate = true;
          seg.mat.opacity = seg.maxOpacity * fade;
        });
        const hp = this.head.geometry.attributes.position;
        hp.setXYZ(0, this.x, this.y, this.z);
        hp.needsUpdate = true;
        this.hMat.opacity = fade * 0.9;
      }
    }

