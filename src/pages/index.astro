          glitchRenderer.setSize(SIZE, SIZE, false);
          glitchRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
          const glitchScene = new THREE.Scene();
          const glitchCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
          const photoTexture = new THREE.TextureLoader().load('/rasmus-new-cyberpunk2.png', () => {
            photoTexture.minFilter = THREE.LinearFilter;
            photoTexture.magFilter = THREE.LinearFilter;
            canvas.classList.add('active');
