---
import Layout from '../layouts/Layout.astro';

const year = new Date().getFullYear();

const skills = [
  'C#', 'Java', 'JavaScript', 'TypeScript', 'Python',
  '.NET', 'Node.js', 'React', 'MySQL', 'PostgreSQL',
  'Docker', 'AWS', 'CI/CD', 'REST APIs', 'Linux',
  'Agile', 'TDD', 'Git', 'Architecture',
];

const projects = [
  {
    name: 'Wee',
    desc: 'Hosted agent sandboxes for software development. Let AI coding agents do real work in isolated, on-demand cloud environments with real-time monitoring and multi-agent orchestration.',
    tags: ['AI', 'Developer Tools'],
    href: 'https://wee.cat',
    linkLabel: 'wee.cat',
    featured: true,
  },
  {
    name: 'Donna',
    desc: 'Autonomous AI pentesting platform — orchestrates Claude Code agents via Temporal to find and exploit vulnerabilities.',
    tags: ['Security', 'AI'],
    href: 'https://github.com/schlunsen/donna',
    linkLabel: 'GitHub',
  },
  {
    name: 'Claude Agent SDK Go',
    desc: 'Port of the official Claude Agent Python SDK to Go. Build AI agents with idiomatic Go.',
    tags: ['Go', 'AI', 'SDK'],
    href: 'https://github.com/schlunsen/claude-agent-sdk-go',
    linkLabel: 'GitHub',
  },
  {
    name: 'The Agentic Crew',
    desc: 'Three free books on agentic engineering — for developers, non-coders, and teams. Available in 4 languages with interactive audiobook.',
    tags: ['Books', 'AI', 'Free'],
    href: 'https://theagenticcrew.com',
    linkLabel: 'theagenticcrew.com',
  },
  {
    name: 'Web Presenter',
    desc: 'Interactive presentation framework with Three.js backgrounds, audio narration, and CSS animations.',
    tags: ['Three.js', 'Web'],
    href: 'https://github.com/schlunsen/web-presenter',
    linkLabel: 'GitHub',
  },
  {
    name: 'Maperick',
    desc: 'Visualize active TCP connections on a world map. Available as a TUI and a native Mac app.',
    tags: ['Networking', 'macOS', 'TUI'],
    href: 'https://github.com/schlunsen/maperick',
    linkLabel: 'GitHub',
  },
  {
    name: 'Hefty',
    desc: 'A fast disk usage analyzer inspired by GrandPerspective — CLI tool and native macOS app. Find the hefty files hogging your disk.',
    tags: ['Rust', 'macOS', 'TUI'],
    href: 'https://github.com/schlunsen/hefty',
    linkLabel: 'GitHub',
  },
  {
    name: 'Radio CLI',
    desc: 'Internet radio player — Rust terminal UI plus a native macOS menu bar app. Audio visualization and station discovery.',
    tags: ['Rust', 'macOS', 'TUI'],
    href: 'https://github.com/schlunsen/radio-cli',
    linkLabel: 'GitHub',
  },
];

const work = [
  {
    name: 'Clovr Labs',
    role: 'Founder & Consultant',
    place: 'Barcelona, ES',
    desc: 'Software consultancy — technical strategy and hands-on development.',
    now: true,
  },
  {
    name: 'Consulting',
    role: 'Senior Developer',
    place: 'Barcelona, ES',
    desc: 'Full-stack solutions, modernizing tech stacks and dev practices.',
    now: false,
  },
  {
    name: 'Copenhagen',
    role: 'Software Developer',
    place: 'Copenhagen, DK',
    desc: 'Enterprise applications, agile cross-functional teams.',
    now: false,
  },
];
---

<Layout title="Rasmus Schlünsen — Software Consultant & Developer">
  <div class="glitch-overlay" id="glitchOverlay" aria-hidden="true"></div>

  <!-- NAV -->
  <nav class="site-nav">
    <a href="/" class="site-logo" aria-label="Home">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
        <circle cx="14" cy="14" r="13" stroke="#181614" stroke-width="1"/>
        <circle cx="14" cy="14" r="4" fill="#c89355"/>
      </svg>
    </a>
    <div class="site-nav-links">
      <a href="#work">Work</a>
      <a href="#projects">Projects</a>
      <a href="#stack">Stack</a>
      <a href="#contact">Contact</a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <svg class="hero-geo" viewBox="0 0 1200 800" fill="none" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <circle cx="820" cy="300" r="220" stroke="#cfc7b6" stroke-width="1.5"/>
      <circle cx="820" cy="300" r="120" stroke="#e0d9ca" stroke-width="1"/>
      <circle cx="720" cy="200" r="50" fill="#c89355" opacity="0.18"/>
      <circle cx="920" cy="180" r="12" fill="#c89355" opacity="0.5"/>
      <line x1="600" y1="0" x2="900" y2="800" stroke="#cfc7b6" stroke-width="1"/>
      <line x1="0" y1="520" x2="700" y2="520" stroke="#e0d9ca" stroke-width="1"/>
      <polygon points="950,450 1010,570 890,570" fill="none" stroke="#f74f39" stroke-width="1.5" opacity="0.35"/>
      <circle cx="200" cy="300" r="8" fill="#00ac5c" opacity="0.6"/>
      <path d="M 50 650 A 120 120 0 0 1 170 530" stroke="#f74f39" stroke-width="2" opacity="0.25" fill="none"/>
      <line x1="500" y1="80" x2="500" y2="720" stroke="#ece5d7" stroke-width="1"/>
    </svg>
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-l1 glitch" data-text="Rasmus">Rasmus</span>
        <span class="hero-l2 glitch" data-text="Schlünsen">Schlünsen</span>
      </h1>
      <div class="hero-info">
        <div class="hero-info-item">
          <span class="mono-label">role</span>
          <p>Software Consultant<br/>& Developer</p>
        </div>
        <div class="hero-info-item">
          <span class="mono-label">base</span>
          <p>Barcelona, ES</p>
        </div>
        <div class="hero-info-item">
          <span class="mono-label">status</span>
          <p class="hero-status"><span class="green-dot"></span> Available</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about" id="about">
    <div class="section-wrap about-grid">
      <div class="about-art">
        <svg viewBox="0 0 400 400" fill="none" style="width: 100%; max-width: 300px;" aria-hidden="true">
          <circle cx="200" cy="200" r="180" stroke="#e0d9ca" stroke-width="1"/>
          <circle cx="200" cy="200" r="120" stroke="#e0d9ca" stroke-width="1"/>
          <circle cx="200" cy="200" r="60" stroke="#cfc7b6" stroke-width="1"/>
          <line x1="20" y1="200" x2="380" y2="200" stroke="#e0d9ca" stroke-width="1"/>
          <line x1="200" y1="20" x2="200" y2="380" stroke="#e0d9ca" stroke-width="1"/>
          <circle cx="200" cy="80" r="8" fill="#c89355" opacity="0.6"/>
          <circle cx="320" cy="200" r="5" fill="#00ac5c" opacity="0.6"/>
          <polygon points="200,140 230,190 170,190" fill="none" stroke="#f74f39" stroke-width="1" opacity="0.4"/>
        </svg>
      </div>
      <div class="about-text">
        <h2>Building software<br/>with precision<br/>and purpose.</h2>
        <p>15+ years crafting solutions across the full stack. From Copenhagen to Barcelona — always focused on what matters: clean architecture, real impact.</p>
        <p>Currently running Clovr Labs. Fluent in English, Danish, and Spanish. 2× DIA Award winner.</p>
        <div class="about-meta">
          <div class="meta-row"><span class="mono-label">education</span><span class="meta-val">Business Academy West</span></div>
          <div class="meta-row"><span class="mono-label">focus</span><span class="meta-val">C#, Java, Databases, CCNA, Agile, TDD</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section class="work" id="work">
    <div class="section-wrap">
      <h2>Work</h2>
      <div class="work-ledger">
        {work.map((w) => (
          <div class="work-row">
            <div class="work-name">
              <h3>{w.name}</h3>
              {w.now && <span class="now-badge">NOW</span>}
            </div>
            <span class="work-role">{w.role}</span>
            <span class="work-place">{w.place}</span>
            <p class="work-desc">{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section class="projects" id="projects">
    <div class="section-wrap">
      <div class="projects-head">
        <h2>Projects</h2>
        <span class="meta-val projects-count">{projects.length} open builds</span>
      </div>

      {projects.filter((p) => p.featured).map((p) => (
        <a href={p.href} target="_blank" rel="noopener noreferrer" class="project-featured">
          <div class="project-featured-info">
            <div class="project-title">
              <h3>{p.name}</h3>
              <span class="link-arrow">↗</span>
            </div>
            <p>{p.desc}</p>
            <div class="project-tags">
              {p.tags.map((t) => <span class="project-tag">{t}</span>)}
              <span class="project-link-label">{p.linkLabel}</span>
            </div>
          </div>
          <figure class="project-shot">
            <img src="/wee-hero.png" alt="Wee — hosted agent sandboxes, product screenshot" loading="lazy" width="1200" height="675" />
          </figure>
        </a>
      ))}

      <div class="project-grid">
        {projects.filter((p) => !p.featured).map((p, i) => (
          <a href={p.href} target="_blank" rel="noopener noreferrer" class={`project-card project-card-${i < 3 ? 's' : 'w'}`}>
            <div class="project-title">
              <h3>{p.name}</h3>
              <span class="link-arrow">↗</span>
            </div>
            <p>{p.desc}</p>
            <div class="project-tags">
              {p.tags.map((t) => <span class="project-tag">{t}</span>)}
              <span class="project-link-label">{p.linkLabel}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- STACK -->
  <section class="stack" id="stack">
    <div class="section-wrap stack-grid">
      <div class="stack-left">
        <h2>Tools &<br/>technologies</h2>
        <svg viewBox="0 0 280 280" fill="none" style="width: 100%; max-width: 220px; margin-top: 12px;" aria-hidden="true">
          <circle cx="140" cy="140" r="130" stroke="#e0d9ca" stroke-width="1"/>
          <circle cx="80" cy="100" r="35" stroke="#cfc7b6" stroke-width="1"/>
          <circle cx="210" cy="85" r="18" fill="#c89355" opacity="0.18"/>
          <line x1="0" y1="170" x2="280" y2="110" stroke="#e0d9ca" stroke-width="1"/>
          <polygon points="140,45 170,105 110,105" fill="none" stroke="#f74f39" stroke-width="1" opacity="0.3"/>
          <circle cx="190" cy="210" r="7" fill="#00ac5c" opacity="0.5"/>
          <rect x="55" y="190" width="45" height="45" fill="none" stroke="#e0d9ca" stroke-width="1" transform="rotate(18 78 213)"/>
        </svg>
      </div>
      <div class="stack-right">
        {skills.map((s) => (
          <span class="skill-tag">{s}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact" id="contact">
    <div class="section-wrap contact-grid">
      <div class="contact-art">
        <svg viewBox="0 0 200 200" fill="none" style="width: 100%; max-width: 180px; opacity: 0.7;" aria-hidden="true">
          <circle cx="100" cy="100" r="90" stroke="#e0d9ca" stroke-width="1"/>
          <circle cx="100" cy="100" r="30" fill="#c89355" opacity="0.14"/>
          <line x1="10" y1="100" x2="190" y2="100" stroke="#e0d9ca" stroke-width="1"/>
          <line x1="100" y1="10" x2="100" y2="190" stroke="#e0d9ca" stroke-width="1"/>
          <circle cx="100" cy="10" r="4" fill="#00ac5c"/>
        </svg>
      </div>
      <div class="contact-body">
        <h2>Let's<br/>connect.</h2>
        <p>Open to projects, collaborations, and interesting challenges.</p>
        <div class="contact-links">
          <a href="https://www.linkedin.com/in/rasmusbs/" target="_blank" rel="noopener noreferrer" class="contact-link">
            <span>LinkedIn</span><span class="link-arrow">→</span>
          </a>
          <a href="https://github.com/schlunsen" target="_blank" rel="noopener noreferrer" class="contact-link">
            <span>GitHub</span><span class="link-arrow">→</span>
          </a>
        </div>
        <div class="contact-langs">
          <span class="mono-label">languages</span>
          <span class="meta-val">English · Danish · Spanish</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="section-wrap footer-inner">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="10" cy="10" r="9" stroke="#cfc7b6" stroke-width="1"/>
        <circle cx="10" cy="10" r="3" fill="#cfc7b6"/>
      </svg>
      <span>&copy; {year} Rasmus Schlünsen</span>
    </div>
  </footer>
  <script>
    const overlay = document.getElementById('glitchOverlay');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    function triggerGlitch() {
      if (reduceMotion.matches || !overlay) return;
      overlay.innerHTML = '';
      overlay.classList.remove('flash');
      const count = Math.floor(Math.random() * 6) + 4;
      for (let i = 0; i < count; i++) {
        const line = document.createElement('div');
        const roll = Math.random();
        line.className = 'glitch-line' + (roll > 0.85 ? ' signal' : roll > 0.7 ? ' amber' : '');
        line.style.top = Math.random() * 100 + '%';
        line.style.height = Math.random() * 3 + 1 + 'px';
        overlay.appendChild(line);
      }
      void overlay.offsetHeight;
      overlay.classList.add('flash');
    }

    document.querySelectorAll('.site-nav-links a').forEach((a) =>
      a.addEventListener('click', triggerGlitch)
    );
    window.addEventListener('load', () => setTimeout(triggerGlitch, 400));
  </script>
</Layout>

<style is:global>
  /* Hallmark · redesign pass · theme: studied-DNA (source: DESIGN.md — Hyperstudio)
   * display: Archivo · body: Inter · mono: JetBrains Mono · accent: amber #e7c59a
   * work section: typographic ledger (no icon-tile grid) · eyebrows: off
   */

  /* === SHARED === */
  .section-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0;
  }

  .mono-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--color-faint);
    display: block;
  }

  .meta-val {
    font-size: 14px;
    color: var(--color-meta);
    line-height: 1.5;
  }

  /* === NAV === */
  .site-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) 40px;
    background: var(--color-paper-veil);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }

  .site-logo { display: block; transition: transform var(--dur-med) var(--ease-out); }
  .site-logo:hover { transform: rotate(90deg); }

  .site-nav-links { display: flex; gap: var(--space-xl); }
  .site-nav-links a {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--track-mono);
    color: var(--color-body);
    text-transform: uppercase;
    white-space: nowrap;
    transition: color var(--dur-short) var(--ease-out);
  }
  .site-nav-links a:hover { color: var(--color-ink); }

  /* === HERO === */
  .hero {
    position: relative;
    min-height: min(92svh, 900px);
    display: flex;
    align-items: flex-end;
    padding: 80px 40px;
    overflow: hidden;
    background: var(--color-paper);
  }

  .hero-geo {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-3xl);
  }

  .hero-title { flex: 1; }

  .hero-l1, .hero-l2 {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(56px, 10vw, 120px);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.04em;
  }
  .hero-l1 { color: var(--color-ink); }
  .hero-l2 { color: var(--color-faint); padding-left: 0.5em; }

  .hero-info {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex-shrink: 0;
    width: 220px;
    padding-bottom: var(--space-xs);
  }

  .hero-info-item {
    border-top: 1px solid var(--color-line-strong);
    padding-top: 10px;
  }
  .hero-info-item .mono-label { margin-bottom: var(--space-2xs); }
  .hero-info-item p {
    font-size: 15px;
    color: var(--color-ink);
    line-height: 1.4;
  }

  .hero-status { display: flex; align-items: center; gap: var(--space-xs); }

  .green-dot {
    width: 6px; height: 6px;
    background: var(--color-positive);
    border-radius: 50%;
    display: inline-block;
    animation: pulse 2.5s var(--ease-in-out) infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  /* === GLITCH — periodic RGB-split burst on the name === */
  .glitch { position: relative; }
  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    opacity: 0;
    pointer-events: none;
  }
  .hero-l2.glitch::before,
  .hero-l2.glitch::after { padding-left: 0.5em; }
  .glitch::before {
    color: var(--color-signal);
    animation: glitch-a 7s steps(1, end) infinite;
  }
  .glitch::after {
    color: var(--color-accent);
    animation: glitch-b 7s steps(1, end) infinite;
  }
  .hero-l2.glitch::before,
  .hero-l2.glitch::after { animation-delay: 3.5s; }

  @keyframes glitch-a {
    0%, 94% { opacity: 0; transform: none; clip-path: inset(0 0 100% 0); }
    94.5% { opacity: 0.7; transform: translate(-7px, 2px); clip-path: inset(12% 0 58% 0); }
    95.5% { opacity: 0.7; transform: translate(5px, -1px); clip-path: inset(62% 0 8% 0); }
    96.5% { opacity: 0.7; transform: translate(-3px, 1px); clip-path: inset(35% 0 42% 0); }
    97%, 100% { opacity: 0; transform: none; clip-path: inset(0 0 100% 0); }
  }
  @keyframes glitch-b {
    0%, 94.2% { opacity: 0; transform: none; clip-path: inset(0 0 100% 0); }
    94.7% { opacity: 0.7; transform: translate(6px, -2px); clip-path: inset(55% 0 18% 0); }
    95.7% { opacity: 0.7; transform: translate(-5px, 1px); clip-path: inset(8% 0 72% 0); }
    96.7% { opacity: 0.7; transform: translate(3px, -1px); clip-path: inset(44% 0 30% 0); }
    97.2%, 100% { opacity: 0; transform: none; clip-path: inset(0 0 100% 0); }
  }

  /* === GLITCH — full-screen line flash on load + nav jumps === */
  .glitch-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
  }
  .glitch-line {
    position: absolute;
    left: 0; right: 0;
    background: var(--color-ink);
    opacity: 0;
  }
  .glitch-line.signal { background: var(--color-signal); }
  .glitch-line.amber { background: var(--color-accent); }
  .glitch-overlay.flash .glitch-line {
    animation: glitchFlash 0.35s var(--ease-out) forwards;
  }
  @keyframes glitchFlash {
    0% { opacity: 0.4; transform: translateX(-10px); }
    40% { opacity: 0.2; transform: translateX(8px); }
    100% { opacity: 0; transform: none; }
  }

  /* === ABOUT === */
  .about {
    padding: var(--space-5xl) 40px var(--space-4xl);
    border-top: 1px solid var(--color-line);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 80px;
    align-items: center;
  }

  .about-art {
    display: flex;
    justify-content: center;
  }

  .about-text {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .about-text h2 {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .about-text p {
    max-width: 44ch;
  }

  .about-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
  }

  .meta-row {
    display: flex;
    gap: var(--space-lg);
    align-items: baseline;
  }
  .meta-row .mono-label { min-width: 80px; flex-shrink: 0; }

  /* === WORK — typographic ledger === */
  .work {
    padding: var(--space-4xl) 40px var(--space-5xl);
    border-top: 1px solid var(--color-line);
  }

  .work h2 {
    font-size: clamp(32px, 5vw, 48px);
    line-height: 0.95;
    margin-bottom: var(--space-2xl);
  }

  .work-ledger {
    border-top: 1px solid var(--color-line);
  }

  .work-row {
    display: grid;
    grid-template-columns: 1.1fr 1fr 0.7fr 1.4fr;
    gap: var(--space-lg);
    align-items: baseline;
    padding: var(--space-lg) var(--space-md);
    border-bottom: 1px solid var(--color-line);
    transition: background-color var(--dur-med) var(--ease-out);
  }
  .work-row:hover { background: var(--color-surface-raised); }

  .work-name {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .work-name h3 {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .now-badge {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-accent-wash);
    border: 1px solid var(--color-accent-line);
    padding: 2px var(--space-xs);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }

  .work-role {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-faint);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
  }

  .work-place {
    font-family: var(--font-mono);
