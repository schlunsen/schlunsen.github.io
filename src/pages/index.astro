---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { projects, bench, story } from '../data/projects';

const pad = (n: number) => String(n).padStart(2, '0');
const REEL = { src: '/media/rasmus-schlunsen-reel.mp4', poster: '/media/rasmus-schlunsen-reel-poster.jpg' };
const archived = [
  { title: 'Plates', note: 'Engraved, like a treatise', when: 'Sep 2026', src: '/media/reels/plates.mp4', poster: '/media/reels/plates.jpg' },
  { title: 'Cut paper', note: 'Collage, after Miró', when: 'Sep 2026', src: '/media/reels/collage.mp4', poster: '/media/reels/collage.jpg' },
  { title: 'Painted', note: 'Watercolour and ink', when: 'Sep 2026', src: '/media/reels/painted.mp4', poster: '/media/reels/painted.jpg' },
  { title: 'The original', note: 'Swiss editorial', when: 'Sep 2026', src: '/media/reels/swiss.mp4', poster: '/media/reels/swiss.jpg' },
];
const repoSlug = (url?: string) => url?.replace('https://github.com/', '') ?? '';
---

<Layout title="Rasmus Schlünsen · Engineer & Creator">
  <Nav page="home" />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero" aria-labelledby="hero-title">
      <canvas class="hills" id="hills" aria-hidden="true"></canvas>

      <div class="hero-inner">
        <div class="hero-copy">
          <p class="kicker status"><span class="live" aria-hidden="true"></span>Barcelona · Software &amp; systems · Available for select projects</p>
          <h1 id="hero-title" class="marker">
            <span class="w" style="--i:0; --rot:-2deg">Engineer</span>
            <span class="line2">
              <span class="w amp" style="--i:1; --rot:6deg">&amp;</span>
              <span class="w creator" style="--i:2; --rot:-1deg">Creator<svg class="swoosh" viewBox="0 0 300 30" preserveAspectRatio="none" aria-hidden="true"><path d="M4 20 C 60 8, 140 26, 200 14 S 280 10, 296 16" pathLength="1" /></svg></span>
            </span>
          </h1>
          <p class="tagline">Software engineer building AI agents, developer tools and open source. Fifteen years of shipping, from security to wind turbines to agents.</p>
          <div class="cta">
            <a class="btn primary" href="#work">See the work <span aria-hidden="true">↓</span></a>
            <a class="btn" href="#reel" data-reel-open>Watch the reel <span aria-hidden="true">▶</span></a>
          </div>
          <p class="socials">
            <a href="https://github.com/schlunsen" target="_blank" rel="me noopener">GitHub ↗</a>
            <a href="https://www.linkedin.com/in/rasmusbs/" target="_blank" rel="me noopener">LinkedIn ↗</a>
          </p>
        </div>

      </div>


      <a class="scroll-cue kicker" href="#reel" aria-label="Scroll to the reel">scroll <span aria-hidden="true">↓</span></a>
    </section>

    <!-- ============ REEL ============ -->
    <section class="section reel" id="reel" aria-labelledby="reel-title">
      <div class="section-head" data-reveal>
        <p class="kicker"><b>Reel</b> — Fifteen years in 60 seconds</p>
        <h2 id="reel-title">The short film</h2>
      </div>
      <figure class="reel-frame" data-reveal style="--r:-.6deg">
        <span class="tape" style="--t: var(--teal); top: -12px; left: -18px; transform: rotate(-32deg);" aria-hidden="true"></span>
        <span class="tape" style="--t: var(--teal); bottom: -10px; right: -16px; transform: rotate(-30deg);" aria-hidden="true"></span>
        <button type="button" class="reel-video" id="reelOpen" aria-label="Play the reel, full screen with sound">
          <video id="reelVideo" muted loop playsinline preload="none" tabindex="-1" aria-hidden="true"
            poster="/media/rasmus-schlunsen-reel-poster.jpg">
            <source src="/media/rasmus-schlunsen-reel.mp4" type="video/mp4">
          </video>
          <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" /></svg></span>
        </button>
        <figcaption>
          <span class="kicker">Security, Unity, wind turbines, crypto forensics, n0. 60 seconds.</span>
          <button type="button" class="btn sound" id="reelPlay">Play with sound <span aria-hidden="true">▶</span></button>
        </figcaption>
      </figure>

      <div class="archive" data-reveal>
        <h3 class="kicker"><b>More takes</b> — The same story, other styles</h3>
        <ul>
          {archived.map((r, i) => (
            <li style={`--r:${i % 2 ? 1.2 : -1.4}deg`}>
              <button type="button" class="archived" data-reel-src={r.src} data-reel-poster={r.poster} aria-label={`Play the ${r.title.toLowerCase()} reel`}>
                <span class="thumb"><img src={r.poster} alt="" loading="lazy" width="800" height="450" /><span class="mini-play" aria-hidden="true">▶</span></span>
                <span class="meta"><strong class="marker">{r.title}</strong><span>{r.note} · {r.when}</span></span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ WORK ============ -->
    <section class="section work" id="work" aria-labelledby="work-title">
      <div class="section-head" data-reveal>
        <p class="kicker"><b>Work</b> — Selected projects</p>
        <h2 id="work-title">Always building. <em>Always shipping.</em></h2>
      </div>

      <div class="cards">
        {projects.map((p, i) => (
          <article class="card" style={`--t: var(--${p.tint}); --r: ${i % 2 ? 0.9 : -1.1}deg`} data-reveal>
            <span class="tape" style={`top:-12px; ${i % 2 ? 'right:22%' : 'left:18%'}; transform: rotate(${i % 2 ? 4 : -3}deg)`} aria-hidden="true"></span>
            <header>
              <span class="num marker">{pad(i + 1)}</span>
              <h3 class="marker">{p.name}</h3>
              <ul class="tags" aria-label="Tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
            </header>

            {p.shots.length > 0 ? (
              <div class="media">
              <button type="button" class:list={['shots', { books: p.books }]} data-shots={JSON.stringify(p.shots)} data-name={p.name} aria-label={`Open ${p.shots.length} image${p.shots.length > 1 ? 's' : ''} of ${p.name}`}>
                {p.books
                  ? p.shots.map((s, k) => <img src={s} alt="" loading="lazy" decoding="async" style={`--k:${k}`} />)
                  : <img src={p.shots[0]} alt="" loading="lazy" decoding="async" />}
                {!p.books && p.shots.length > 1 && <span class="more">+{p.shots.length - 1} more</span>}
              </button>
              {p.video && (
                <button type="button" class="film marker" data-reel-src={p.video.src} data-reel-poster={p.video.poster} data-reel-label={p.video.about}>
                  <span class="film-play" aria-hidden="true">▶</span>{p.video.label}
                </button>
              )}
              </div>
            ) : p.private ? (
              <div class="classified" aria-hidden="true">
                <span class="redact" style="width:78%"></span><span class="redact" style="width:52%"></span><span class="redact" style="width:66%"></span><span class="redact" style="width:40%"></span>
                <span class="stamp marker">Private<br>for now</span>
              </div>
            ) : (
              <div class="term" aria-hidden="true">
                <span class="dots"><i></i><i></i><i></i></span>
                <code>$ {p.install ?? `git clone github.com/${repoSlug(p.repo)}`}<span class="caret"></span></code>
              </div>
            )}

            <p class="desc">{p.desc}</p>
            <p class="links">
              {p.private && <span class="kicker">Private · ask me</span>}
              {p.video && <a href={p.video.src} data-reel-src={p.video.src} data-reel-poster={p.video.poster} data-reel-label={p.video.about}>{p.video.label} <span aria-hidden="true">▶</span></a>}
              {p.site && <a href={p.site} target="_blank" rel="noopener">Visit <span aria-hidden="true">↗</span></a>}
              {p.repo && <a href={p.repo} target="_blank" rel="noopener">Code <span aria-hidden="true">↗</span></a>}
            </p>
          </article>
        ))}
      </div>

      <div class="bench" data-reveal>
        <h3 class="marker">Also on the bench</h3>
        <ul>
          {bench.map((b) => (
            <li>
              {b.url ? <a href={b.url} target="_blank" rel="noopener">{b.name} ↗</a> : <strong>{b.name}</strong>}
              <span> — {b.note}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ STORY ============ -->
    <section class="section story" id="story" aria-labelledby="story-title">
      <div class="story-grid">
        <div class="story-side">
          <div class="section-head" data-reveal>
            <p class="kicker"><b>Story</b> — How I got here</p>
            <h2 id="story-title">Fifteen years. <em>Building what's next.</em></h2>
          </div>
          <div class="sticker" data-reveal style="--r:-4deg">
            <span class="star" aria-hidden="true">★</span>
            <p class="marker">2013</p>
            <p>Two Danish Internet Awards for the MSF “Like” campaign.</p>
          </div>
        </div>

        <ol class="timeline">
          {story.map((s, i) => (
            <li class:list={[{ brief: s.brief }]} style={`--t: var(--${s.tint}); --r:${i % 2 ? 0.6 : -0.6}deg`} data-reveal>
              <span class="dot" aria-hidden="true"></span>
              <p class="kicker">{s.when}</p>
              <h3><span class="marker">{s.title}</span> <em>{s.em}</em></h3>
              <p>{s.body}{s.link && <> <a class="tl-link" href={s.link.href} target="_blank" rel="noopener">{s.link.label} ↗</a></>}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ============ ABOUT ============ -->
    <section class="section about" id="about" aria-labelledby="about-title">
      <div class="about-inner">
        <figure class="about-me" data-reveal style="--r:3deg">
          <span class="tape" style="--t: var(--clay); top: -12px; left: 30%; transform: rotate(-6deg);" aria-hidden="true"></span>
          <img src="/media/me-cutout.webp" width="720" height="900" alt="Rasmus smiling" loading="lazy">
        </figure>
        <div class="section-head" data-reveal>
          <p class="kicker"><b>About</b></p>
          <h2 id="about-title">I'm Rasmus. <em>Hej, hola, hi.</em></h2>
        </div>
        <div class="about-text" data-reveal>
          <p>Software consultant in Barcelona, fifteen years in, currently at <strong>Clovr Labs</strong>. A system architect at heart who loves the creative side just as much: robust backends, and interactions that make software feel alive.</p>
          <p>Python, Go, Rust and JavaScript across the stack. Deep into AI and agentic systems.</p>
          <p>Danish by birth, English at work, Spanish in progress.</p>
          <p class="off"><span class="kicker">Off the clock</span> Making creative things, playing with my kids, and playing music.</p>
          <p class="sig marker" aria-hidden="true">— Rasmus</p>
        </div>
        <ul class="skills" data-reveal aria-label="Skills">
          {['Python', 'Go', 'Rust', 'JavaScript', 'SQL', 'System architecture', 'Full-stack web', 'AI / ML', 'Agentic systems', 'Security', 'Creative coding'].map((s, i) => (
            <li style={`--r:${((i * 37) % 7) - 3}deg`}>{s}</li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Big-screen reel player -->
  <dialog class="reel-modal" id="reelModal" aria-label="Reel">
    <form method="dialog"><button class="lb-close btn" aria-label="Close">✕</button></form>
    <video id="reelBig" controls playsinline preload="none" poster="/media/rasmus-schlunsen-reel-poster.jpg"
      aria-label="A 60-second film: fifteen years of Rasmus Schlünsen's work, from a security internship in 2010 and a Unity3D final project to OrbiSCADA, Clovr Labs and n0.">
      <source src="/media/rasmus-schlunsen-reel.mp4" type="video/mp4">
    </video>
  </dialog>

  <!-- Lightbox for project images -->
  <dialog class="lightbox" id="lightbox" aria-label="Project images">
    <form method="dialog"><button class="lb-close btn" aria-label="Close">✕</button></form>
    <button type="button" class="lb-nav btn prev" id="lbPrev" aria-label="Previous image">←</button>
    <figure>
      <img id="lbImg" src="" alt="">
      <figcaption class="kicker" id="lbCap"></figcaption>
    </figure>
    <button type="button" class="lb-nav btn next" id="lbNext" aria-label="Next image">→</button>
  </dialog>
</Layout>

<script define:vars={{ REEL }} is:inline>window.__REEL = REEL;</script>

<script>
  import { paintHills } from '../scripts/hills';
  const REEL = (window as any).__REEL as { src: string; poster: string };

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ---- painted hills ----
  const hills = document.getElementById('hills') as HTMLCanvasElement | null;
  if (hills) {
    try { paintHills(hills, ['.hero-copy', '.top']); } catch (e) { console.warn('hills: could not paint', e); }
  }

  // ---- reel: silent looping preview inline, big-screen player with sound in a modal ----
  const reel = document.getElementById('reelVideo') as HTMLVideoElement | null;
  const modal = document.getElementById('reelModal') as HTMLDialogElement | null;
  const big = document.getElementById('reelBig') as HTMLVideoElement | null;
  if (reel) {
    new IntersectionObserver(([e]) => {
      if (reduce.matches || modal?.open) return;
      if (e.isIntersecting) reel.play().catch(() => {}); else reel.pause();
    }, { threshold: 0.35 }).observe(reel);
  }
  const bigSource = big?.querySelector('source');
  const reelLabel = big?.getAttribute('aria-label') ?? '';
  const openReel = (e?: Event, src = REEL.src, poster = REEL.poster, label = reelLabel) => {
    if (!modal || !big) return;
    e?.preventDefault();
    reel?.pause();
    big.setAttribute('aria-label', label);
    if (bigSource && bigSource.getAttribute('src') !== src) {
      bigSource.setAttribute('src', src);
      big.poster = poster;
      big.load();
    }
    modal.showModal();
    big.currentTime = 0;
    big.muted = false;
    big.play().catch(() => {});
  };
  document.getElementById('reelOpen')?.addEventListener('click', (e) => openReel(e));
  document.getElementById('reelPlay')?.addEventListener('click', (e) => openReel(e));
  document.querySelectorAll('[data-reel-open]').forEach((a) => a.addEventListener('click', (e) => openReel(e)));
  document.querySelectorAll<HTMLElement>('[data-reel-src]').forEach((b) =>
    b.addEventListener('click', (e) => openReel(e, b.dataset.reelSrc!, b.dataset.reelPoster!, b.dataset.reelLabel || reelLabel)));
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
  modal?.addEventListener('close', () => {
    big?.pause();
    if (reel && !reduce.matches) reel.play().catch(() => {});
  });

  // ---- lightbox ----
  const lb = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lbImg') as HTMLImageElement | null;
  const lbCap = document.getElementById('lbCap');
  let shots: string[] = [], idx = 0, name = '';
  const show = (i: number) => {
    if (!lbImg || !lbCap) return;
    idx = (i + shots.length) % shots.length;
    lbImg.src = shots[idx];
    lbImg.alt = `${name}, image ${idx + 1} of ${shots.length}`;
    lbCap.textContent = `${name} · ${idx + 1} / ${shots.length}`;
    lb?.classList.toggle('single', shots.length < 2);
  };
  document.querySelectorAll<HTMLButtonElement>('.shots').forEach((b) => {
    b.addEventListener('click', () => {
      shots = JSON.parse(b.dataset.shots || '[]');
      name = b.dataset.name || '';
      if (!shots.length || !lb) return;
      show(0);
      lb.showModal();
    });
  });
  document.getElementById('lbPrev')?.addEventListener('click', () => show(idx - 1));
  document.getElementById('lbNext')?.addEventListener('click', () => show(idx + 1));
  lb?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(idx + 1);
    if (e.key === 'ArrowLeft') show(idx - 1);
  });
  lb?.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });

  // ---- hello, devtools ----
  console.log('%c✎ hej!', 'font: 700 28px "Permanent Marker", cursive; color:#D97757');
  console.log('%cYou opened devtools. That already tells me something good about you.\nLet’s talk → https://www.linkedin.com/in/rasmusbs/', 'color:#2B2233; font-size:12px; line-height:1.8');
</script>

<style>
  /* ================= HERO ================= */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6.5rem var(--gutter) 0;
    overflow: hidden;
  }
  .hills {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-bottom: 26vh;
  }

  .status { display: flex; align-items: center; gap: .55rem; flex-wrap: wrap; }
  .live {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--sap);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--sap) 60%, transparent);
    animation: live 2.4s ease-out infinite;
  }
  @keyframes live { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--sap) 60%, transparent); } 80%, 100% { box-shadow: 0 0 0 10px transparent; } }

  h1 {
    font-size: clamp(3.4rem, 10vw, 7.6rem);
    line-height: .92;
    margin: 1.1rem 0 1.4rem;
    color: var(--ink);
  }
  h1 .w {
    display: inline-block;
    transform: rotate(var(--rot));
    animation: pop .7s cubic-bezier(.3,1.7,.5,1) calc(.35s + var(--i) * .16s) both;
  }
  html.wipe-intro h1 .w { animation-delay: calc(1.55s + var(--i) * .16s); }
  .line2 { display: block; white-space: nowrap; }
  h1 .amp { color: var(--clay); font-family: var(--hand); font-style: italic; font-weight: 700; font-size: .78em; margin-right: .1em; }
  h1 .creator { position: relative; }
  .swoosh {
    position: absolute; left: -2%; right: -4%; bottom: -.12em;
    width: 106%; height: .3em;
    overflow: visible;
    filter: url(#rough);
  }
  .swoosh path {
    fill: none; stroke: var(--clay); stroke-width: 9; stroke-linecap: round;
    stroke-dasharray: 1 1; stroke-dashoffset: 1;
    animation: draw .7s cubic-bezier(.6,0,.3,1) 1s forwards;
  }
  html.wipe-intro .swoosh path { animation-delay: 2.2s; }
  @keyframes pop { from { opacity: 0; transform: rotate(var(--rot)) scale(.4) translateY(20px); } to { opacity: 1; transform: rotate(var(--rot)) scale(1); } }
  @keyframes draw { to { stroke-dashoffset: 0; } }

  .tagline { font-size: clamp(1.05rem, 1.6vw, 1.22rem); max-width: 34rem; color: var(--ink-soft); }
  .cta { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 1.8rem; }
  .socials { display: flex; gap: 1.25rem; margin-top: 1.4rem; font-family: var(--mono); font-size: .82rem; }
  .socials a { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; text-decoration-color: var(--clay); }
  .socials a:hover { color: var(--clay-dk); }

  /* portrait: no frame, standing next to the text, just behind the front hills */
  .portrait {
    position: relative;
    justify-self: center;
    align-self: end;
    width: min(100%, 50svh, 470px);
    margin: 0 0 -15vh;              /* feet (well, shoulders) go behind the front hills */
    animation: rise 1s cubic-bezier(.2,.9,.3,1) .5s both;
  }
  html.wipe-intro .portrait { animation-delay: 1.7s; }
  @keyframes rise { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: none; } }
  .hills-front { z-index: 2; mix-blend-mode: normal; }
  .hero-copy { position: relative; z-index: 3; }
  .me { position: relative; aspect-ratio: 4 / 5; }
  .me img, .me canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .me img { object-fit: cover; transition: opacity .6s ease; }
  .me canvas { opacity: 0; transition: opacity .6s ease; }
  .me.ready canvas { opacity: 1; }
  .me.ready img { opacity: 0; }

  .portrait figcaption {
    position: absolute;
    z-index: 3;
    left: -2%; top: -1%;
    display: flex; flex-direction: column; align-items: flex-start; gap: .1rem;
    transform: rotate(-8deg);
    pointer-events: none;
  }
  .hi {
    position: relative;
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    color: var(--clay-dk);
    white-space: nowrap;
    padding: .1rem .35rem;
    background: linear-gradient(transparent 60%, color-mix(in srgb, var(--ochre) 55%, transparent) 60% 92%, transparent 92%);
    animation: hi-pop .6s cubic-bezier(.3,1.7,.5,1) 1.3s both;
  }
  html.wipe-intro .hi { animation-delay: 2.5s; }
  .wave { display: inline-block; margin-left: .3rem; transform-origin: 70% 80%; animation: wave 2.6s ease-in-out 2s infinite; }
  .hi-arrow { width: clamp(80px, 6.5vw, 110px); height: auto; margin: .1rem 0 0 3.2rem; overflow: visible; filter: url(#rough); }
  .hi-arrow path { fill: none; stroke: var(--ink); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1 1; stroke-dashoffset: 1; }
  .hi-arrow .shaft { animation: draw .9s cubic-bezier(.6,0,.3,1) 1.6s forwards; }
  .hi-arrow .head { animation: draw .25s ease-out 2.45s forwards; }
  html.wipe-intro .hi-arrow .shaft { animation-delay: 2.8s; }
  html.wipe-intro .hi-arrow .head { animation-delay: 3.65s; }
  @keyframes hi-pop { from { opacity: 0; transform: scale(.5) rotate(-10deg); } to { opacity: 1; transform: none; } }
  @keyframes wave { 0%, 60%, 100% { transform: rotate(0); } 10%, 30% { transform: rotate(18deg); } 20%, 40% { transform: rotate(-10deg); } }
  .portrait figcaption button {
    pointer-events: auto;
    margin-top: .3rem;
    background: none; border: 0; cursor: pointer;
    font-family: var(--mono); font-size: .7rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: underline; text-underline-offset: 3px;
  }

  .scroll-cue {
    position: absolute; left: 50%; bottom: 1.2rem; z-index: 1;
    transform: translateX(-50%);
    color: var(--cream);
    text-decoration: none;
    animation: bob 2s ease-in-out infinite;
  }
  @keyframes bob { 50% { transform: translate(-50%, 6px); } }

  /* ================= REEL ================= */
  .reel-frame {
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(8px, 1.4vw, 14px);
  }
  .reel-frame::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
