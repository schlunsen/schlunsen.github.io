        setTimeout(() => {
          preloaderContent.classList.add('hidden');
          setTimeout(() => {
            pageTrans.classList.remove('preload');
            pageTrans.classList.add('exit');
            preloaderContent.style.display = 'none';
            if (window._stopPreloaderGlitch) window._stopPreloaderGlitch();
            setTimeout(() => {
              pageTrans.classList.remove('exit');
            }, 700);
          }, 300);
        }, 500);
      }, 1200);
    });

    // Console easter egg
    console.log(
      '%c \u2318 ',
      'font-size:48px;color:#818cf8;font-weight:bold;'
    );
    console.log(
      '%cYou opened devtools.%c\nThat already tells me something good about you.',
      'color:#818cf8;font-size:14px;font-weight:600;line-height:1.8',
      'color:#94a3b8;font-size:12px;font-weight:400;line-height:1.8'
    );
    console.log(
      '%cLet\'s talk \u2192 https://linkedin.com/in/rasmusbs/',
      'color:#64748b;font-size:11px;font-style:italic;line-height:2'
    );

    // Intercept internal navigation links
    document.querySelectorAll('a[href="/hire"]').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const href = link.getAttribute('href');
        pageTrans.classList.add('active');
        setTimeout(() => {
          window.location.href = href;
        }, 600);
      });
    });
  </script>
</Layout>

