---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import gourceScreenshot from '../assets/gource-viewer.png';
import '../styles/portfolio.css';
const archive = [
  {
    name: 'Wee',
    desc: 'Hosted agent sandboxes for software development. Let AI coding agents do real work in isolated, on-demand cloud environments with real-time monitoring and multi-agent orchestration.',
    tags: ['AI', 'Developer Tools'],
    href: 'https://wee.cat',
    linkLabel: 'wee.cat',
    featured: true,
  },
  {
    name: 'Donna',
    desc: 'Autonomous AI pentesting platform — orchestrates Claude Code agents via Temporal to find and exploit vulnerabilities.',
    tags: ['Security', 'AI'],
    href: 'https://github.com/schlunsen/donna',
    linkLabel: 'GitHub',
  },
  {
    name: 'Claude Agent SDK Go',
    desc: 'Port of the official Claude Agent Python SDK to Go. Build AI agents with idiomatic Go.',
    tags: ['Go', 'AI', 'SDK'],
    href: 'https://github.com/schlunsen/claude-agent-sdk-go',
    linkLabel: 'GitHub',
  },
  {
    name: 'The Agentic Crew',
    desc: 'Three free books on agentic engineering — for developers, non-coders, and teams. Available in 4 languages with interactive audiobook.',
    tags: ['Books', 'AI', 'Free'],
    href: 'https://theagenticcrew.com',
    linkLabel: 'theagenticcrew.com',
  },
  {
    name: 'Web Presenter',
    desc: 'Interactive presentation framework with Three.js backgrounds, audio narration, and CSS animations.',
    tags: ['Three.js', 'Web'],
    href: 'https://github.com/schlunsen/web-presenter',
    linkLabel: 'GitHub',
  },
  {
    name: 'Maperick',
    desc: 'Visualize active TCP connections on a world map. Available as a TUI and a native Mac app.',
    tags: ['Networking', 'macOS', 'TUI'],
    href: 'https://github.com/schlunsen/maperick',
    linkLabel: 'GitHub',
  },
  {
    name: 'Hefty',
    desc: 'A fast disk usage analyzer inspired by GrandPerspective — CLI tool and native macOS app. Find the hefty files hogging your disk.',
    tags: ['Rust', 'macOS', 'TUI'],
    href: 'https://github.com/schlunsen/hefty',
    linkLabel: 'GitHub',
  },
  {
    name: 'Radio CLI',
    desc: 'Internet radio player — Rust terminal UI plus a native macOS menu bar app. Audio visualization and station discovery.',
    tags: ['Rust', 'macOS', 'TUI'],
    href: 'https://github.com/schlunsen/radio-cli',
    linkLabel: 'GitHub',
  },
];


const year = new Date().getFullYear();
---
<Layout title="Rasmus Schlünsen — Independent developer & creative technologist" description="Independent software consultant and developer in Barcelona. 15+ years building thoughtful software, developer tools, and agentic systems. Explore selected work by Rasmus Schlünsen.">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="nav" id="site-header">
    <div class="nav-inner">
      <a class="wordmark" href="#" aria-label="Rasmus Schlünsen, home"><span class="wm-l">r</span><span class="wm-reveal">asmus&nbsp;</span><span class="wm-l">s</span><span class="wm-reveal">chlünsen</span><span class="wm-reg" aria-hidden="true">®</span></a>
      <span class="nav-caption">Independent developer<br/>Copenhagen → Barcelona<span class="clock" aria-label="Local time in Barcelona"><span data-hh>––</span><span class="colon">:</span><span data-mm>––</span></span></span>
      <nav aria-label="Main navigation">
        <a href="#projects" data-section="projects"><span class="roll"><span>Selected work</span><span aria-hidden="true">Selected work</span></span><span class="count">09</span></a>
        <a href="#about" data-section="about"><span class="roll"><span>About</span><span aria-hidden="true">About</span></span></a>
        <a class="nav-contact" href="#contact" data-section="contact"><span class="roll"><span>Let’s talk</span><span aria-hidden="true">Let’s talk</span></span><span class="arrow">↗</span></a>
        <i class="nav-indicator" aria-hidden="true"></i>
      </nav>
    </div>
    <i class="nav-progress" aria-hidden="true"></i>
  </header>
  <main id="main">
    <section class="intro" aria-labelledby="intro-title">
      <div class="intro-top"><span class="eyebrow">Rasmus Schlünsen / Software & systems</span><span class="availability"><i></i> Available for select projects</span></div>
      <h1 id="intro-title">Serious code.<br/><span>Curious mind.</span></h1>
      <div class="intro-bottom"><p>I turn complex problems into software<br class="desktop-break"/> that feels simple. Built with purpose.<br class="desktop-break"/> Made to move things forward.</p><a class="round-link" href="#projects"><span>Explore my work</span><span class="circle">↓</span></a></div>
      <div class="system-art" aria-hidden="true"><canvas id="system-canvas"></canvas><span class="art-coordinate">FIG. 001 — A LIVING SYSTEM</span><span class="art-note">CODE / CONNECTION / POSSIBILITY</span></div>
      <div class="hero-foot"><span>15+ years of building what’s next</span><button id="motion-toggle" type="button" aria-pressed="false">Pause motion <span>Ⅱ</span></button><span>Scroll to discover ↓</span></div>
    </section>
    <section class="selected section" id="projects" aria-labelledby="projects-title">
      <div class="section-heading"><span class="eyebrow">01 / Selected work</span><h2 id="projects-title">Ideas, made real<span class="accent">.</span></h2><p>Independent builds. Open explorations.<br/>Useful things that needed to exist.</p></div>
      <article class="feature gource-feature">
        <a class="feature-visual graph-visual" href="https://schlunsen.github.io/gource-view/" target="_blank" rel="noopener noreferrer" aria-label="Try the Gource Viewer live demo">
          <div class="visual-top"><span>GOURCE VIEWER</span><span>REPOSITORY HISTORY, ALIVE ↗</span></div>
          <Image src={gourceScreenshot} alt="Gource View visualizing the Express repository, with branching files, contributor activity, and a commit timeline" widths={[560, 840, 1400]} sizes="(max-width: 600px) 90vw, 52vw" format="webp" loading="lazy" class="gource-screenshot" />
          <div class="visual-bottom"><span>EXPRESS / 300 COMMITS / 76 AUTHORS</span><span>Actual product capture</span></div>
        </a>
        <div class="feature-info">
          <div class="project-index"><span>01 / Developer tools</span><span class="new-label">Latest project</span></div>
          <h3>Gource Viewer</h3>
          <p>Watch a codebase come to life. Explore repository history as an animated world of files, folders, and contributors. Try curated repositories in the browser, or self-host to explore your own and export MP4 films.</p>
          <div class="feature-bottom gource-links">
            <a href="https://schlunsen.github.io/gource-view/" target="_blank" rel="noopener noreferrer" class="text-link" id="gource-link">Try the live demo ↗</a>
            <a href="https://github.com/schlunsen/gource-view" target="_blank" rel="noopener noreferrer" class="text-link">View source ↗</a>
          </div>
        </div>
      </article>
      <article class="feature wee-feature">
        <a class="feature-visual wee-visual" href="https://wee.cat" target="_blank" rel="noopener noreferrer" aria-label="Explore Wee"><span class="visual-top">WEE / AGENT INFRASTRUCTURE <span>↗</span></span><img src="/wee-hero.png" alt="Wee mascot: a cat riding a rocket" width="1200" height="675" loading="lazy"/><span class="visual-bottom">A LITTLE SPACE. A LOT OF POSSIBILITY.</span></a>
        <div class="feature-info"><div class="project-index"><span>02 / AI & infrastructure</span><span>Featured</span></div><h3>Wee <span class="wee-editor-name">/ Wee Editor</span></h3>
          <p>Give your agents room to work. Wee brings hosted agent sandboxes together with Wee Editor, a self-hosted AI workspace for running agent sessions, accessing terminals, and tracking usage in real time.</p>
          <div class="feature-bottom wee-links">
            <a class="text-link" href="https://wee.cat" target="_blank" rel="noopener noreferrer">Explore Wee ↗</a>
            <a class="text-link" href="https://github.com/schlunsen/wee-editor" target="_blank" rel="noopener noreferrer">Wee Editor on GitHub ↗</a>
          </div></div>
      </article>
      <div class="archive-heading"><h3>More from the workshop</h3><span class="eyebrow">Always building. Always curious.</span></div>
      <div class="archive">{archive.filter(p=>!p.featured).map((p,i)=><a href={p.href} target="_blank" rel="noopener noreferrer" class="archive-row"><span class="archive-number">{String(i+3).padStart(2,'0')}</span><div><h3>{p.name}</h3><p>{p.desc}</p></div><span class="archive-tags">{p.tags.join(' / ')}</span><span class="archive-arrow" aria-hidden="true">↗</span></a>)}</div>
    </section>
    <section class="about-section section" id="about"><div class="about-top"><span class="eyebrow">02 / The person behind the code</span><span class="eyebrow">Danish roots. Barcelona base.</span></div><div class="about-grid"><h2>Good software<br/>starts with<br/><em>good questions.</em></h2><div class="about-copy"><p>I’m Rasmus, a software consultant and developer with 15+ years of turning complex challenges into things people can actually use.</p><p>From Copenhagen to Barcelona, my approach has stayed the same: understand the problem, question the obvious, and build with care. Today, I run Clovr Labs and explore what’s possible with AI and agentic systems.</p><div class="facts"><div><strong>15+</strong><span>Years shipping</span></div><div><strong>2×</strong><span>DIA Award winner</span></div><div><strong>3</strong><span>Languages spoken</span></div></div></div></div><div class="practice"><span class="eyebrow">My practice</span><p>Software architecture <b>·</b> Full-stack development <b>·</b> AI & agentic systems <b>·</b> Developer tools</p></div><div class="practice" id="stack"><span class="eyebrow">Tools of the trade</span><p>Python / Go / Rust / TypeScript / C# / .NET / React / PostgreSQL / Docker / AWS</p></div><div class="experience" id="work"><span class="eyebrow">The journey</span><div><span>Clovr Labs</span><span>Founder & Consultant</span><span>Barcelona · Now</span></div><div><span>Consulting</span><span>Senior Developer</span><span>Barcelona</span></div><div><span>Copenhagen</span><span>Software Developer</span><span>Denmark</span></div></div></section>
    <section class="contact-section section" id="contact"><div class="contact-top"><span class="eyebrow">03 / Start a conversation</span><span class="availability"><i></i> Open to interesting challenges</span></div><h2>What are you<br/><a href="https://www.linkedin.com/in/rasmusbs/" target="_blank" rel="noopener noreferrer">thinking<span>↗</span></a>?</h2><div class="contact-bottom"><p>A new product, a thorny problem, or an idea<br/>you can’t stop thinking about. Let’s talk.</p><div><a href="https://www.linkedin.com/in/rasmusbs/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href="https://github.com/schlunsen" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></div></section>
  </main>
  <footer><span>© {year} Rasmus Schlünsen</span><span>Built with curiosity. Based in Barcelona.</span><a href="#">Back to top ↑</a></footer>
  <script>import '../scripts/system';import '../scripts/header';</script>
</Layout>
