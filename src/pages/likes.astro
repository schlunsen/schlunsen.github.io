---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const likes = [
  {
    name: 'Hacker News', url: 'https://news.ycombinator.com', glyph: 'Y', tint: 'clay',
    note: 'The comments are often better than the articles.',
    tags: ['News', 'Discussion'],
  },
  {
    name: 'Reddit', url: 'https://reddit.com', glyph: 'r/', tint: 'rose',
    note: 'Niche deep dives: Rust, Go, AI, self-hosting.',
    tags: ['Communities', 'Discussion'],
  },
  {
    name: 'GitHub Trending', url: 'https://github.com/trending', glyph: '★', tint: 'sap',
    note: 'New open source, before it blows up.',
    tags: ['Open source', 'Code'],
  },
  {
    name: 'Hugging Face Spaces', url: 'https://huggingface.co/spaces', glyph: '🤗', tint: 'ochre',
    note: 'AI demos you can try instantly.',
    tags: ['AI', 'Models', 'Demos'],
  },
  {
    name: 'Long walks in front of the fireplace', glyph: '🔥', tint: 'teal',
    note: 'Back and forth, in front of a crackling fire. Pure bliss.',
    tags: ['Cozy', 'Relaxation'],
  },
];
---

<Layout title="Likes · Rasmus Schlünsen" description="Sites and things Rasmus Schlünsen likes: daily reads, playgrounds and a fireplace.">
  <Nav page="likes" />

  <main id="main" class="likes">
    <header class="head" data-reveal>
      <p class="kicker"><b>Pinned to the wall</b> — Things I like</p>
      <h1 class="marker">Daily reads<span class="amp">&amp;</span><br>other joys</h1>
      <p>Where I find projects and ideas. Plus one non-negotiable hobby.</p>
    </header>

    <ul class="board">
      {likes.map((l, i) => {
        const body = (
          <>
            <span class="pin" aria-hidden="true"></span>
            <span class="glyph marker" aria-hidden="true">{l.glyph}</span>
            <h2 class="marker">{l.name}{l.url && <span class="arrow" aria-hidden="true"> ↗</span>}</h2>
            <p>{l.note}</p>
            <ul class="tags" aria-label="Tags">{l.tags.map((t) => <li>{t}</li>)}</ul>
          </>
        );
        return (
          <li class="note" style={`--t: var(--${l.tint}); --r: ${[-2.5, 1.8, -1.2, 2.4, -1.8][i % 5]}deg`} data-reveal>
            {l.url ? <a href={l.url} target="_blank" rel="noopener">{body}</a> : <div>{body}</div>}
          </li>
        );
      })}
    </ul>
  </main>

  <Footer />
</Layout>

<style>
  .likes {
    max-width: 1100px;
    margin: 0 auto;
    padding: 8.5rem var(--gutter) 5rem;
  }
  .head { margin-bottom: 3.5rem; max-width: 640px; }
  .head h1 { font-size: clamp(3rem, 9vw, 6rem); line-height: .95; margin: .8rem 0 1rem; }
  .head .amp { color: var(--clay); font-family: var(--hand); font-style: italic; font-weight: 700; font-size: .7em; margin-left: .15em; display: inline-block; transform: rotate(8deg); }
  .head p:not(.kicker) { color: var(--ink-soft); font-size: 1.1rem; }

  .board {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
    gap: 2.4rem 2rem;
  }
  .note > a, .note > div {
    position: relative;
    display: flex; flex-direction: column; gap: .6rem;
    height: 100%;
    padding: 2rem 1.4rem 1.3rem;
    text-decoration: none;
    background: color-mix(in srgb, var(--t) 30%, var(--cream));
    border: 2.5px solid var(--ink);
    border-radius: 2px 4px 3px 5px;
    box-shadow: 5px 7px 0 var(--ink);
    transition: transform .25s cubic-bezier(.3,1.6,.5,1), box-shadow .25s;
  }
  /* folded corner */
  .note > a::after, .note > div::after {
    content: ''; position: absolute; right: -2.5px; bottom: -2.5px;
    width: 28px; height: 28px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--t) 55%, var(--ink)) 50%, var(--paper) 50%);
    border-left: 2.5px solid var(--ink); border-top: 2.5px solid var(--ink);
    border-radius: 0 0 2px 0;
  }
  .note > a:hover { transform: rotate(calc(var(--r) * -.5)) translateY(-5px); box-shadow: 8px 12px 0 var(--ink); }
  .pin {
    position: absolute; top: -11px; left: 50%;
    width: 22px; height: 22px; margin-left: -11px;
    background: radial-gradient(circle at 35% 35%, #fff8 0 20%, transparent 22%), var(--clay);
    border: 2.5px solid var(--ink);
    border-radius: 50%;
  }
  .glyph {
    width: 54px; height: 54px;
    display: grid; place-items: center;
    font-size: 1.5rem;
    background: var(--cream);
    border: 2.5px solid var(--ink);
    border-radius: 60% 40% 55% 45% / 45% 55% 45% 55%;
  }
  h2 { font-size: 1.55rem; line-height: 1.1; }
  .arrow { color: var(--clay-dk); }
  .note p { color: var(--ink-soft); flex: 1; }
  .tags { list-style: none; display: flex; gap: .35rem; flex-wrap: wrap; }
  .tags li {
    font-family: var(--mono); font-size: .68rem;
    padding: .1rem .55rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: var(--cream);
  }
</style>
