---
const items = [
  {
    company: 'Clovr Labs',
    role: 'Founder & Consultant',
    location: 'Barcelona, ES',
    desc: 'Software consultancy — technical strategy and hands-on development.',
    current: true,
  },
  {
    company: 'Consulting',
    role: 'Senior Developer',
    location: 'Barcelona, ES',
    desc: 'Full-stack solutions, modernizing tech stacks and dev practices.',
    current: false,
  },
  {
    company: 'Copenhagen',
    role: 'Software Developer',
    location: 'Copenhagen, DK',
    desc: 'Enterprise applications, agile cross-functional teams.',
    current: false,
  },
];

const shapes = [
  '<circle cx="24" cy="24" r="18" fill="none" stroke="#e7c59a" stroke-width="1.5"/><circle cx="24" cy="24" r="6" fill="#e7c59a"/>',
  '<polygon points="24,6 42,42 6,42" fill="none" stroke="#555" stroke-width="1.5"/>',
  '<rect x="8" y="8" width="32" height="32" fill="none" stroke="#555" stroke-width="1.5" transform="rotate(12 24 24)"/>',
];
---

<section id="work">
  <div class="wrap">
    <span class="lbl">// experience</span>
    <h2>Work</h2>
    <div class="grid">
      {items.map((item, i) => (
        <div class="card">
          <div class="shape">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" set:html={shapes[i]} />
          </div>
          <div class="card-body">
            <div class="card-top">
              <h3>{item.company}</h3>
              {item.current && <span class="now">NOW</span>}
            </div>
            <span class="role">{item.role} — {item.location}</span>
            <p>{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    padding: 96px 40px;
    border-top: 1px solid #212121;
  }

  .wrap {
    max-width: 1100px;
    margin: 0 auto;
  }

  .lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: -0.037em;
    text-transform: uppercase;
    color: #666;
    display: block;
    margin-bottom: 16px;
  }

  h2 {
    font-size: clamp(32px, 5vw, 48px);
    line-height: 0.95;
    margin-bottom: 64px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: #212121;
    border: 1px solid #212121;
    border-radius: 8px;
    overflow: hidden;
  }

  .card {
    background: #0c0c0c;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    transition: background 0.3s ease;
  }

  .card:hover {
    background: #141414;
  }

  .shape { height: 48px; }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  h3 {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #f3f3f3;
  }

  .now {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #e7c59a;
    background: rgba(231, 197, 154, 0.1);
    border: 1px solid rgba(231, 197, 154, 0.2);
    padding: 2px 8px;
    border-radius: 99px;
  }

  .role {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #666;
    letter-spacing: -0.037em;
  }

  .card p {
    font-size: 14px;
    color: #949494;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    section { padding: 64px 24px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
