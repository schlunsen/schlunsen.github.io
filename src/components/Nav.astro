---
interface Props {
  page?: 'home' | 'likes' | 'other';
}
const { page = 'home' } = Astro.props;
const home = page === 'home' ? '' : '/';
const links = [
  { href: `${home}#reel`, label: 'Reel' },
  { href: `${home}#work`, label: 'Work' },
  { href: `${home}#story`, label: 'Story' },
  { href: `${home}#about`, label: 'About' },
  { href: '/likes', label: 'Likes', current: page === 'likes' },
];
---

<header class="top" id="top">
  <a href="/" class="logo marker" aria-label="Rasmus Schlünsen, home">
    <span class="logo-dot" aria-hidden="true"></span>Rasmus Schlünsen
  </a>
  <nav aria-label="Main">
    <ul>
      {links.map((l) => (
        <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const top = document.getElementById('top');
  const onScroll = () => top?.classList.toggle('scrolled', window.scrollY > 24);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .top {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .9rem var(--gutter);
    transition: background .3s, box-shadow .3s, padding .3s;
  }
  .top.scrolled {
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding-top: .6rem; padding-bottom: .6rem;
    box-shadow: 0 2px 0 var(--ink);
  }

  .logo {
    display: inline-flex; align-items: center; gap: .55rem;
    font-size: 1.2rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .logo-dot {
    width: 16px; height: 16px;
    background: var(--clay);
    border: 2px solid var(--ink);
    border-radius: 60% 40% 55% 45% / 50% 60% 40% 50%;
    transition: transform .3s cubic-bezier(.3,1.6,.5,1);
  }
  .logo:hover .logo-dot { transform: rotate(160deg) scale(1.2); }

  ul { list-style: none; display: flex; gap: .15rem; }
  nav a {
    display: block;
    font-family: var(--mono);
    font-size: .78rem;
    letter-spacing: .06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: .4rem .7rem;
    border-radius: 999px;
    position: relative;
  }
  nav a::after {
    content: '';
    position: absolute; left: .7rem; right: .7rem; bottom: .15rem;
    height: 3px;
    background: var(--clay);
    border-radius: 3px;
    transform: scaleX(0) rotate(-1deg);
    transform-origin: left;
    transition: transform .25s ease;
  }
  nav a:hover::after, nav a[aria-current='page']::after { transform: scaleX(1) rotate(-1deg); }

  @media (max-width: 720px) {
    .top { flex-direction: column; align-items: flex-start; gap: .25rem; padding-top: .7rem; padding-bottom: .5rem; }
    .top.scrolled { padding-top: .45rem; padding-bottom: .35rem; }
    .logo { font-size: 1.05rem; }
    ul { margin-left: -.55rem; flex-wrap: wrap; }
    nav a { font-size: .7rem; padding: .3rem .55rem; }
  }
</style>
