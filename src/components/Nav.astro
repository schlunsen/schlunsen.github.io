---
---

<nav>
  <div class="nav-wrap">
    <a href="/" class="logo">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
        <circle cx="14" cy="14" r="13" stroke="#f3f3f3" stroke-width="1"/>
        <circle cx="14" cy="14" r="4" fill="#e7c59a"/>
      </svg>
    </a>
    <div class="links">
      <a href="#work">Work</a>
      <a href="#stack">Stack</a>
      <a href="#contact">Contact</a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(16, 16, 16, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid #212121;
    padding: 16px 40px;
  }

  .nav-wrap {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: block;
    transition: transform 0.3s ease;
  }
  .logo:hover { transform: rotate(90deg); }

  .links {
    display: flex;
    gap: 32px;
  }

  .links a {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: -0.037em;
    color: #949494;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .links a:hover { color: #f3f3f3; }
</style>
