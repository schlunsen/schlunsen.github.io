<section id="contact">
  <div class="wrap">
    <div class="left">
      <svg viewBox="0 0 200 200" fill="none" class="art">
        <circle cx="100" cy="100" r="90" stroke="#2a2a2a" stroke-width="1"/>
        <circle cx="100" cy="100" r="30" fill="#e7c59a" opacity="0.06"/>
        <line x1="10" y1="100" x2="190" y2="100" stroke="#2a2a2a" stroke-width="1"/>
        <line x1="100" y1="10" x2="100" y2="190" stroke="#2a2a2a" stroke-width="1"/>
        <circle cx="100" cy="10" r="4" fill="#00ac5c"/>
      </svg>
    </div>
    <div class="right">
      <span class="lbl">// contact</span>
      <h2>Let's<br/>connect.</h2>
      <p>Open to projects, collaborations, and interesting challenges.</p>
      <div class="links">
        <a href="https://www.linkedin.com/in/rasmusbs/" target="_blank" rel="noopener noreferrer">
          <span>LinkedIn</span>
          <span class="arrow">→</span>
        </a>
        <a href="https://github.com/schlunsen" target="_blank" rel="noopener noreferrer">
          <span>GitHub</span>
          <span class="arrow">→</span>
        </a>
      </div>
      <div class="langs">
        <span class="lbl">languages</span>
        <span class="val">English · Danish · Spanish</span>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 96px 40px;
    border-top: 1px solid #212121;
  }

  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: center;
  }

  .left {
    display: flex;
    justify-content: center;
  }

  .art {
    width: 100%;
    max-width: 180px;
    opacity: 0.7;
  }

  .right {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: -0.037em;
    text-transform: uppercase;
    color: #666;
  }

  h2 {
    font-size: clamp(40px, 6vw, 64px);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  section p {
    max-width: 36ch;
  }

  .links {
    display: flex;
    flex-direction: column;
    border-top: 1px solid #212121;
  }

  .links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid #212121;
    transition: padding-left 0.2s ease;
    text-decoration: none;
  }

  .links a:hover {
    padding-left: 12px;
  }

  .links a span:first-child {
    font-size: 18px;
    font-weight: 600;
    color: #f3f3f3;
  }

  .arrow {
    font-size: 20px;
    color: #666;
    transition: color 0.2s;
  }

  .links a:hover .arrow {
    color: #e7c59a;
  }

  .langs {
    display: flex;
    gap: 24px;
    align-items: baseline;
    padding-top: 8px;
  }

  .val {
    font-size: 14px;
    color: #c1c1c1;
  }

  @media (max-width: 768px) {
    section { padding: 64px 24px; }
    .wrap { grid-template-columns: 1fr; gap: 48px; }
    .left { order: -1; }
    .art { max-width: 120px; }
  }
</style>
