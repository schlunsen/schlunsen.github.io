---
---

<section id="about">
  <div class="wrap">
    <div class="left">
      <svg viewBox="0 0 400 400" fill="none" class="art">
        <circle cx="200" cy="200" r="180" stroke="#2a2a2a" stroke-width="1"/>
        <circle cx="200" cy="200" r="120" stroke="#2a2a2a" stroke-width="1"/>
        <circle cx="200" cy="200" r="60" stroke="#333" stroke-width="1"/>
        <line x1="20" y1="200" x2="380" y2="200" stroke="#2a2a2a" stroke-width="1"/>
        <line x1="200" y1="20" x2="200" y2="380" stroke="#2a2a2a" stroke-width="1"/>
        <circle cx="200" cy="80" r="8" fill="#e7c59a" opacity="0.5"/>
        <circle cx="320" cy="200" r="5" fill="#00ac5c" opacity="0.6"/>
        <polygon points="200,140 230,190 170,190" fill="none" stroke="#f74f39" stroke-width="1" opacity="0.4"/>
        <text x="200" y="225" text-anchor="middle" font-family="Inter, system-ui" font-size="80" font-weight="800" fill="#f3f3f3" opacity="0.05">15+</text>
      </svg>
    </div>
    <div class="right">
      <span class="lbl">// about</span>
      <h2>Building software<br/>with precision<br/>and purpose.</h2>
      <div class="body">
        <p>15+ years crafting solutions across the full stack. From Copenhagen to Barcelona — always focused on what matters: clean architecture, real impact.</p>
        <p>Currently running Clovr Labs. Fluent in English, Danish, and Spanish. 2× DIA Award winner.</p>
      </div>
      <div class="meta">
        <div class="meta-row">
          <span class="lbl">education</span>
          <span class="val">Business Academy West</span>
        </div>
        <div class="meta-row">
          <span class="lbl">focus</span>
          <span class="val">C#, Java, Databases, CCNA, Agile, TDD</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 96px 40px;
    border-top: 1px solid #212121;
  }

  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 80px;
    align-items: center;
  }

  .left {
    display: flex;
    justify-content: center;
  }

  .art {
    width: 100%;
    max-width: 320px;
  }

  .right {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: -0.037em;
    text-transform: uppercase;
    color: #666;
  }

  h2 {
    font-size: clamp(28px, 4vw, 40px);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .body p {
    max-width: 44ch;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid #212121;
  }

  .meta-row {
    display: flex;
    gap: 24px;
    align-items: baseline;
  }

  .meta-row .lbl {
    min-width: 80px;
    flex-shrink: 0;
  }

  .val {
    font-size: 14px;
    color: #c1c1c1;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    section { padding: 64px 24px; }
    .wrap { grid-template-columns: 1fr; gap: 48px; }
    .art { max-width: 200px; }
  }
</style>
