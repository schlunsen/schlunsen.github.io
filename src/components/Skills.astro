---
const skills = [
  'C#', 'Java', 'JavaScript', 'TypeScript', 'Python',
  '.NET', 'Node.js', 'React', 'MySQL', 'PostgreSQL',
  'Docker', 'AWS', 'CI/CD', 'REST APIs', 'Linux',
  'Agile', 'TDD', 'Git', 'System Architecture',
];
---

<section id="stack">
  <div class="wrap">
    <div class="left">
      <span class="lbl">// stack</span>
      <h2>Tools &<br/>technologies</h2>
      <svg viewBox="0 0 280 280" fill="none" class="art">
        <circle cx="140" cy="140" r="130" stroke="#2a2a2a" stroke-width="1"/>
        <circle cx="80" cy="100" r="35" stroke="#333" stroke-width="1"/>
        <circle cx="210" cy="85" r="18" fill="#e7c59a" opacity="0.08"/>
        <line x1="0" y1="170" x2="280" y2="110" stroke="#2a2a2a" stroke-width="1"/>
        <polygon points="140,45 170,105 110,105" fill="none" stroke="#f74f39" stroke-width="1" opacity="0.3"/>
        <circle cx="190" cy="210" r="7" fill="#00ac5c" opacity="0.5"/>
        <rect x="55" y="190" width="45" height="45" fill="none" stroke="#2a2a2a" stroke-width="1" transform="rotate(18 78 213)"/>
      </svg>
    </div>
    <div class="right">
      <div class="cloud">
        {skills.map((s) => (
          <span class="tag">{s}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  section {
    padding: 96px 40px;
    border-top: 1px solid #212121;
    background: #0a0a0a;
  }

  .wrap {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 80px;
    align-items: center;
  }

  .left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .lbl {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: -0.037em;
    text-transform: uppercase;
    color: #666;
  }

  h2 {
    font-size: clamp(28px, 4.5vw, 44px);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .art {
    width: 100%;
    max-width: 240px;
    margin-top: 8px;
  }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    padding: 10px 18px;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    font-size: 14px;
    color: #c1c1c1;
    transition: all 0.25s ease;
    cursor: default;
  }

  .tag:hover {
    border-color: #e7c59a;
    color: #e7c59a;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    section { padding: 64px 24px; }
    .wrap { grid-template-columns: 1fr; gap: 48px; }
    .art { max-width: 180px; }
  }
</style>
